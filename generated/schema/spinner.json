{
  "name": "spinner",
  "tier": 1,
  "summary": "An indeterminate progress indicator with a status message for screen readers.",
  "use": [
    "Short waits where the remaining time is unknown"
  ],
  "avoid": [
    {
      "case": "Loading a layout you can predict",
      "instead": "skeleton"
    },
    {
      "case": "A button that is submitting",
      "instead": "button (loading)"
    }
  ],
  "rendering": "server",
  "platform": {
    "requires": []
  },
  "parts": [
    {
      "jsx": "Spinner",
      "slot": "spinner",
      "element": "span",
      "description": "role=\"status\" with a visually hidden label.",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "label": {
            "default": "読み込み中",
            "description": "Announced to screen readers.",
            "type": "string"
          },
          "showLabel": {
            "default": false,
            "description": "Also display the status label next to the ring.",
            "type": "boolean"
          },
          "size": {
            "default": "md",
            "type": "string",
            "enum": [
              "sm",
              "md",
              "lg"
            ]
          }
        }
      },
      "overrides": [
        "margin",
        "layout",
        "position"
      ]
    }
  ],
  "states": [],
  "a11y": {
    "rules": [
      "label says what is loading when it is not obvious."
    ]
  },
  "tokens": [
    "color.text-muted"
  ],
  "examples": [
    {
      "title": "Loading",
      "code": "<Spinner label=\"検索結果を読み込み中\" />"
    }
  ]
}
