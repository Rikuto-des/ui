{
  "name": "sidebar",
  "tier": 1,
  "summary": "An app's side navigation: groups of links, optionally collapsible with native <details>.",
  "use": [
    "The main navigation of an app with many sections"
  ],
  "avoid": [
    {
      "case": "A short list of top-level pages",
      "instead": "a header nav"
    }
  ],
  "rendering": "server",
  "platform": {
    "requires": [
      "details"
    ]
  },
  "parts": [
    {
      "jsx": "Sidebar",
      "slot": "sidebar",
      "element": "nav",
      "description": "The nav landmark.",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Required. Names the nav landmark."
          }
        },
        "required": [
          "label"
        ]
      },
      "overrides": [
        "margin",
        "width",
        "height",
        "layout",
        "position"
      ]
    },
    {
      "jsx": "Sidebar.Group",
      "slot": "sidebar-group",
      "element": "div",
      "description": "A titled group of items. collapsible makes it a <details>.",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "description": "Required group title.",
            "x-ts-type": "React.ReactNode"
          },
          "collapsible": {
            "default": false,
            "type": "boolean"
          },
          "defaultOpen": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "title"
        ]
      },
      "overrides": []
    },
    {
      "jsx": "Sidebar.Item",
      "slot": "sidebar-item",
      "element": "a",
      "description": "A link. The current page gets aria-current=\"page\".",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "href": {
            "type": "string",
            "minLength": 1,
            "description": "Required link target."
          },
          "current": {
            "default": false,
            "type": "boolean"
          },
          "icon": {
            "description": "Optional decorative icon.",
            "x-ts-type": "React.ReactNode"
          }
        },
        "required": [
          "href"
        ]
      },
      "overrides": []
    }
  ],
  "states": [
    "current",
    "open"
  ],
  "a11y": {
    "rules": [
      "Exactly one item is current per page.",
      "Icons are decorative; the text names the link."
    ]
  },
  "tokens": [
    "color.text-muted",
    "color.ghost-hover",
    "radius.control"
  ],
  "examples": [
    {
      "title": "App",
      "code": "<Sidebar label=\"メイン\">\n  <Sidebar.Group title=\"プロジェクト\">\n    <Sidebar.Item href=\"/tasks\" current>タスク</Sidebar.Item>\n    <Sidebar.Item href=\"/members\">メンバー</Sidebar.Item>\n  </Sidebar.Group>\n</Sidebar>"
    }
  ]
}
