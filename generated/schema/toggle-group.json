{
  "name": "toggle-group",
  "tier": 1,
  "summary": "A segmented control: native radios (one choice) or checkboxes (several) drawn as one row of buttons.",
  "use": [
    "Choosing a view (リスト / ボード)",
    "Text alignment in a toolbar"
  ],
  "avoid": [
    {
      "case": "Navigation between pages",
      "instead": "tabs or links"
    }
  ],
  "rendering": "server",
  "platform": {
    "requires": []
  },
  "parts": [
    {
      "jsx": "ToggleGroup",
      "slot": "toggle-group",
      "element": "fieldset",
      "description": "A fieldset; items get its name and type.",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "legend": {
            "type": "string",
            "minLength": 1,
            "description": "Required. Names the group."
          },
          "hideLegend": {
            "default": true,
            "description": "Keeps the legend for screen readers only.",
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Required form name shared by the items."
          },
          "type": {
            "default": "single",
            "description": "single: radios. multiple: checkboxes.",
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ]
          },
          "defaultValue": {
            "description": "single: the item checked initially.",
            "type": "string"
          },
          "size": {
            "default": "md",
            "type": "string",
            "enum": [
              "sm",
              "md"
            ]
          }
        },
        "required": [
          "legend",
          "name"
        ]
      },
      "overrides": [
        "margin",
        "width",
        "layout",
        "position"
      ]
    },
    {
      "jsx": "ToggleGroup.Item",
      "slot": "toggle-group-item",
      "element": "input",
      "description": "One segment: a radio or checkbox inside a <label>.",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "Required form value."
          }
        },
        "required": [
          "value"
        ]
      },
      "overrides": []
    }
  ],
  "states": [
    "checked"
  ],
  "a11y": {
    "keyboard": {
      "← / →": "move the choice (single)",
      "Space": "toggle (multiple)"
    },
    "rules": [
      "legend is required even when hidden.",
      "Icon-only items need aria-label."
    ]
  },
  "tokens": [
    "color.field",
    "color.text-muted",
    "shadow.control"
  ],
  "examples": [
    {
      "title": "View",
      "code": "<ToggleGroup legend=\"表示\" name=\"view\" defaultValue=\"list\">\n  <ToggleGroup.Item value=\"list\">リスト</ToggleGroup.Item>\n  <ToggleGroup.Item value=\"board\">ボード</ToggleGroup.Item>\n</ToggleGroup>"
    }
  ]
}
