{
  "name": "pagination",
  "tier": 1,
  "summary": "Links to the pages of a long list: previous, numbered pages with gaps, next.",
  "use": [
    "Search results and lists split into pages"
  ],
  "avoid": [
    {
      "case": "A feed that loads more as you scroll",
      "instead": "a load-more Button"
    }
  ],
  "rendering": "server",
  "platform": {
    "requires": []
  },
  "parts": [
    {
      "jsx": "Pagination",
      "slot": "pagination",
      "element": "nav",
      "description": "A nav of links. Each link's href comes from the template, so it works without JavaScript.",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Required. The current page."
          },
          "total": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Required. The number of pages."
          },
          "href": {
            "type": "string",
            "minLength": 1,
            "description": "Required URL template; {page} is replaced, e.g. \"/tasks?page={page}\"."
          },
          "siblings": {
            "default": 1,
            "description": "Pages shown on each side of the current one.",
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "label": {
            "default": "ページ送り",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "page",
          "total",
          "href"
        ]
      },
      "overrides": [
        "margin",
        "width",
        "layout",
        "position"
      ]
    }
  ],
  "states": [
    "current"
  ],
  "a11y": {
    "rules": [
      "The current page has aria-current=\"page\"; each number says \"n ページ目\"."
    ]
  },
  "tokens": [
    "color.text",
    "color.ghost-hover",
    "color.field",
    "shadow.control"
  ],
  "examples": [
    {
      "title": "Tasks",
      "code": "<Pagination page={3} total={12} href=\"/tasks?page={page}\" />"
    }
  ]
}
