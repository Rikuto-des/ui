{
  "name": "popover",
  "styleDependencies": [
    "button"
  ],
  "tier": 2,
  "summary": "A non-modal panel in the top layer (native `popover`), positioned against its trigger with CSS anchor positioning.",
  "use": [
    "Filters or settings attached to a control",
    "Supplementary content that keeps the page usable"
  ],
  "avoid": [
    {
      "case": "A task that must be finished before continuing",
      "instead": "dialog"
    },
    {
      "case": "A list of actions",
      "instead": "menu"
    },
    {
      "case": "A short label on hover",
      "instead": "tooltip"
    }
  ],
  "rendering": "server",
  "platform": {
    "requires": [
      "popover",
      "anchor-positioning",
      "invoker-commands",
      "@starting-style"
    ],
    "enhances": [
      {
        "feature": "overlay-transition",
        "fallback": "the popover closes without an exit animation"
      }
    ]
  },
  "parts": [
    {
      "jsx": "Popover",
      "slot": "popover",
      "element": "div",
      "description": "The popover panel (role=dialog, popover=auto).",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Required. Triggers and close buttons reference it."
          },
          "title": {
            "description": "Accessible title rendered as a heading. Provide title or aria-label.",
            "x-ts-type": "React.ReactNode"
          },
          "side": {
            "default": "bottom",
            "description": "Logical side: start/end follow the writing direction.",
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "start",
              "end"
            ]
          },
          "align": {
            "default": "start",
            "type": "string",
            "enum": [
              "start",
              "center",
              "end"
            ]
          },
          "mode": {
            "default": "auto",
            "description": "auto: light dismiss (Escape / outside click) and closes other auto popovers. manual: only explicit commands.",
            "type": "string",
            "enum": [
              "auto",
              "manual"
            ]
          }
        },
        "required": [
          "id"
        ]
      },
      "overrides": [
        "width",
        "height"
      ]
    },
    {
      "jsx": "Popover.Trigger",
      "slot": "popover-trigger",
      "element": "button",
      "description": "A Button that toggles the popover and acts as its anchor.",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "popover": {
            "type": "string",
            "minLength": 1,
            "description": "Id of the popover to toggle.",
            "x-idref": "popover"
          },
          "variant": {
            "default": "secondary",
            "description": "primary is the single main action of a view. danger is for destructive actions.",
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "ghost",
              "danger"
            ]
          },
          "size": {
            "default": "md",
            "description": "Control height. Density comes from the pack, not from this prop.",
            "type": "string",
            "enum": [
              "sm",
              "md",
              "lg"
            ]
          }
        },
        "required": [
          "popover"
        ]
      },
      "overrides": [
        "margin",
        "width",
        "layout",
        "position"
      ]
    },
    {
      "jsx": "Popover.Close",
      "slot": "popover-close",
      "element": "button",
      "description": "A Button that hides the popover.",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "popover": {
            "type": "string",
            "minLength": 1,
            "description": "Id of the popover to hide.",
            "x-idref": "popover"
          },
          "variant": {
            "default": "secondary",
            "description": "primary is the single main action of a view. danger is for destructive actions.",
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "ghost",
              "danger"
            ]
          },
          "size": {
            "default": "md",
            "description": "Control height. Density comes from the pack, not from this prop.",
            "type": "string",
            "enum": [
              "sm",
              "md",
              "lg"
            ]
          }
        },
        "required": [
          "popover"
        ]
      },
      "overrides": [
        "margin",
        "width",
        "layout",
        "position"
      ]
    }
  ],
  "states": [
    "open"
  ],
  "a11y": {
    "apg": "disclosure (non-modal dialog)",
    "keyboard": {
      "Escape": "close (mode=auto)",
      "Tab": "moves from the trigger into the popover, then back to the page"
    },
    "focus": {
      "initial": "stays on the trigger unless an element inside has autofocus",
      "restore": "the trigger, when focus was inside"
    },
    "rules": [
      "Provide title or aria-label so the panel has an accessible name.",
      "Every Popover.Trigger and Popover.Close must reference an existing Popover id."
    ]
  },
  "tokens": [
    "color.surface.overlay",
    "radius.overlay",
    "shadow.overlay",
    "motion.overlay",
    "popover.offset"
  ],
  "examples": [
    {
      "title": "Filters next to a button",
      "code": "<Popover.Trigger popover=\"filters\">Filters</Popover.Trigger>\n<Popover id=\"filters\" title=\"Filters\" side=\"bottom\" align=\"start\">…</Popover>"
    }
  ]
}
