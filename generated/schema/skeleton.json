{
  "name": "skeleton",
  "tier": 1,
  "summary": "A placeholder shape shown while content loads.",
  "use": [
    "Reserving the space of content that is still loading"
  ],
  "avoid": [
    {
      "case": "An action in progress",
      "instead": "spinner"
    }
  ],
  "rendering": "server",
  "platform": {
    "requires": []
  },
  "parts": [
    {
      "jsx": "Skeleton",
      "slot": "skeleton",
      "element": "div",
      "description": "The placeholder. Hidden from assistive technology; announce loading elsewhere (aria-busy on the region).",
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "shape": {
            "default": "block",
            "type": "string",
            "enum": [
              "block",
              "text",
              "circle"
            ]
          },
          "lines": {
            "default": 1,
            "description": "Number of text lines when shape is text.",
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      },
      "overrides": [
        "margin",
        "width",
        "height",
        "layout",
        "position"
      ]
    }
  ],
  "states": [],
  "a11y": {
    "rules": [
      "Set aria-busy=\"true\" on the region that is loading."
    ]
  },
  "tokens": [
    "color.border",
    "radius.control"
  ],
  "examples": [
    {
      "title": "Text lines",
      "code": "<Skeleton shape=\"text\" lines={3} />"
    }
  ]
}
